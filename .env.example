# Neon Postgres — set automatically by the Vercel ↔ Neon integration
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aifm-tracks
# Public base URL for the bucket (custom domain or R2 dev URL)
R2_PUBLIC_URL=https://tracks.aifm.ro

# Admin auth — single owner login
ADMIN_PASSWORD=change-me
# Long random string used to HMAC-sign the admin cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
